// Shared settings. Put your real values in Local.xcconfig (not checked in).
// Copy Local.example.xcconfig to Local.xcconfig to start.
// Note: in xcconfig files "//" starts a comment, so URLs use $(SLASH).
SLASH = /
GYM_SERVICE_URL = http:$(SLASH)$(SLASH)localhost:3030
SUPABASE_URL = http:$(SLASH)$(SLASH)127.0.0.1:54321
SUPABASE_ANON_KEY =
DEV_LOGIN_EMAIL =
// Google sign-in. Client ids are public (they ship inside the app), not secrets.
// iOS client "Gym iPhone app" for com.timofeic.gym and the web app's client
// (AUTH_GOOGLE_ID), both in Google Cloud project gym-tracker.
GOOGLE_IOS_CLIENT_ID = 903695837668-c65vq3ldr9i7nthm1jlq3793uutbo74l.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID = 903695837668-aunam6fbg8bl6bceuvtc3dlccm0aph9u.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.903695837668-c65vq3ldr9i7nthm1jlq3793uutbo74l
#include? "Local.xcconfig"
