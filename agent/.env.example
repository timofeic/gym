# LiveKit Cloud project (cloud.livekit.io > Settings > Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase (same project as the web app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Claude
ANTHROPIC_API_KEY=
